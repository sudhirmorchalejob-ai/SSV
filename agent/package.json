{
  "name": "ssv-connector-agent",
  "version": "0.6.2",
  "description": "Runs on the distributor's PC. Reads TallyPrime, keeps only each principal's items, and pushes signed batches to the SSV middleware.",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js",
    "sync-once": "node src/index.js --once",
    "test": "node --test",
    "build:exe": "node build-exe.mjs"
  },
  "dependencies": {
    "agentkeepalive": "^4.5.0",
    "axios": "^1.14.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "postject": "^1.0.0-alpha.6"
  }
}
