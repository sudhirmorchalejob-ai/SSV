# TallyPrime XML server on this PC
TALLY_URL=http://localhost:9000
# Company to read; the agent loads it by name if TallyPrime runs as a server with none open
TALLY_COMPANY=
# Each Tally request: ping, then up to 5 attempts, waiting 10 s × attempt between them
TALLY_RETRIES=5
TALLY_RETRY_DELAY_MS=10000

# Where batches go. For ERPNext with the ssv_channel app, open the SSV Distributor
# in ERPNext → Actions → Show Agent Secret, and paste the five lines it shows:
MIDDLEWARE_URL=https://your-erpnext-site
MIDDLEWARE_BATCHES_PATH=/api/method/ssv_channel.api.batches
MIDDLEWARE_CONFIG_PATH=/api/method/ssv_channel.api.config
DISTRIBUTOR_ID=
AGENT_SECRET=

# Local control API (127.0.0.1 only). Any long random string.
LOCAL_PORT=4100
LOCAL_API_TOKEN=

# Minutes between syncs (5 to 1440). "Sync Every" on the SSV Distributor in ERPNext
# takes precedence; this is used until the agent has seen that setting.
SYNC_INTERVAL_MINUTES=5
# How often the running agent asks ERPNext for a new interval or a "Sync now" (min 30)
CONTROL_POLL_SECONDS=120
# Run reports go to the batches path with "batches" replaced by "heartbeat";
# set this only if your middleware uses another route.
# MIDDLEWARE_HEARTBEAT_PATH=/api/method/ssv_channel.api.heartbeat
# First sync starts here instead of the company's starting date (YYYY-MM-DD)
# SYNC_FROM=2025-04-01
# Vouchers per AlterID window
ALTER_ID_WINDOW=250
# Deleted-voucher check: at most this often; fallback looks back this many days
DELETED_CHECK_INTERVAL_MINUTES=60
DELETED_FALLBACK_DAYS=45

# Upload: pending vouchers per page, and max bytes per HTTP request
UPLOAD_PAGE_SIZE=1000
UPLOAD_MAX_BYTES=5242880
# false = retailers' phone, address and PIN code stay on this PC (name, GSTIN and
# state are still sent). The manufacturer's site also deletes any it already has.
SHARE_RETAILER_CONTACTS=true
# Hours between the daily totals each manufacturer's site reconciles against (0 = every run)
RECONCILE_EVERY_HOURS=24

# Optional: where the SQLite store and logs live
# DATA_DIR=C:\ProgramData\SSVConnector\data

# System proxies are ignored unless 1 (so a proxy cannot read distributor data)
USE_PROXY=0
